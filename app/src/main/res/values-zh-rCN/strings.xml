    <!-- Material 1: Burnout Signs -->
    <string name="wellbeing_mat_burnout_title">识别早期过劳与疲劳迹象</string>
    <string name="wellbeing_mat_burnout_desc">加班疲劳在影响日常心理健康之前可能会微妙地累积。请留意以下生理和心理警告信号：</string>
    <string name="wellbeing_mat_burnout_item1">• 慢性生理疲惫：即使睡眠充足后仍感到持续疲劳。</string>
    <string name="wellbeing_mat_burnout_item2">• 认知迷雾：注意力下降、错误增加或决策延迟。</string>
    <string name="wellbeing_mat_burnout_item3">• 情绪疏离：感到愤世嫉俗、易怒或工作成就感丧失。</string>
    <string name="wellbeing_mat_burnout_item4">• 睡眠干扰：由于工作压力或晚下班而难以入睡。</string>

    <!-- Material 2: Shift Work Strategies -->
    <string name="wellbeing_mat_strategies_title">加班恢复策略</string>
    <string name="wellbeing_mat_strategies_desc">保护心理清晰度的工作微习惯（适用于长时间工作）：</string>
    <string name="wellbeing_mat_strategies_item1">• 微休息节奏：每 90 分钟专注工作后休息 3–5 分钟进行呼吸调整。</string>
    <string name="wellbeing_mat_strategies_item2">• 数字离线：严格规定下班后不查看工作邮件或通讯软件。</string>
    <string name="wellbeing_mat_strategies_item3">• 班后放松：睡前进行非屏幕转换活动（如散步、轻度拉伸）。</string>
    <string name="wellbeing_mat_strategies_item4">• 水分与营养：维持能量需要持续补充水分，通宵班期间需摄取平衡膳食。</string>

    <!-- Material 3: Stress Reduction Techniques -->
    <string name="wellbeing_mat_breathing_title">即时减压：箱式呼吸法</string>
    <string name="wellbeing_mat_breathing_desc">在班次中感到不知所措时使用 4-4-4-4 箱式呼吸技术：</string>
    <string name="wellbeing_mat_breathing_step1">1. 用鼻子慢慢吸气 4 秒。</string>
    <string name="wellbeing_mat_breathing_step2">2. 憋气 4 秒。</string>
    <string name="wellbeing_mat_breathing_step3">3. 用嘴平稳呼气 4 秒。</string>
    <string name="wellbeing_mat_breathing_step4">4. 再次憋气 4 秒后进行下一次呼吸。</string>

    <!-- Material 4: Professional Support -->
    <string name="wellbeing_mat_support_title">何时寻求支持</string>
    <string name="wellbeing_mat_support_desc">如果工作压力影响了您的个人健康或人际关系，请寻求专业资源：</string>
    <string name="wellbeing_mat_support_item1">• 员工援助计划 (EAP)：许多雇主提供的机密辅导。</string>
    <string name="wellbeing_mat_support_item2">• 职业健康服务：专门研究轮班工作安全的职场健康顾问。</string>
    <string name="wellbeing_mat_support_item3">• 医疗专业人员：咨询您的全科医生以获取心理健康支持。</string>

    <!-- About Screen -->
    <string name="about_title">关于此应用</string>
    <string name="about_subtitle">了解支持 Shift Tracker 的架构、框架和许可证，旨在支持工作生活平衡和心理健康。</string>
    <string name="about_tech_stack_header">技术栈</string>
    <string name="about_m3_title">原生 Material 3 UI</string>
    <string name="about_m3_desc">此应用使用现代 Jetpack Compose 构建，并严格遵循 Material Design 3 指南。它具有优雅的组件样式、支持全屏渲染、无障碍触控目标，以及利用 M3 色调提升和充足负空间的统一主题。</string>
    <string name="about_kotlin_title">Kotlin 语言</string>
    <string name="about_kotlin_desc">整个代码库使用 Kotlin 编写。它利用了 Kotlin 的高级功能，包括绝对类型安全、使用 Coroutines 和 Flow 实现无缝响应式状态更新的结构化并发，以及标准的现代编码实践。</string>
    <string name="about_room_title">离线 Room 数据库</string>
    <string name="about_room_desc">您的数据保持私密和安全。应用通过 Android Jetpack Room 整合了离线 SQLite 数据库。这确保了可靠的离线数据持久性、原子数据库事务以及流畅的本地状态管理，而不依赖于外部云端 API。</string>
    <string name="about_licensing_header">许可证与法律</string>
    <string name="about_gpl_title">GNU GPL v3 许可证摘要</string>
    <string name="about_gpl_desc">此应用根据 GNU 通用公共许可证第 3 版 (GPL v3) 发布。</string>
    <string name="about_gpl_permissions_title">权限</string>
    <string name="about_gpl_permissions_desc">只要保留作者属性、许可通知并提供源码，您就被允许在商业或私下运行、复制、分发、修改和传达该程序。</string>
    <string name="about_gpl_copyleft_title">Copyleft 规则</string>
    <string name="about_gpl_copyleft_desc">源码的修改版本也必须根据 GPL v3 获得许可。任何分发该软件修改版本的人都必须按照相同的条款发布其源码。</string>
